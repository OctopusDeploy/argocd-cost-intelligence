# Server Configuration
SERVER_PORT=8080

# api serves the REST API; exporter exports every Argo CD Application's cost to Prometheus
# (one replica, in the cluster). See docs/metrics.md.
MODE=api

# Port serving Prometheus /metrics, apart from the API port. 0 turns metrics off (not in exporter mode).
METRICS_PORT=9102

# How often the exporter measures every Application (exporter mode only). At least 1m.
EXPORTER_INTERVAL=5m

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=cost_user
DB_PASSWORD=change-me-in-production
DB_NAME=cost_intelligence
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# OpenCost Configuration
OPENCOST_BASE_URL=http://opencost:9003
OPENCOST_TIMEOUT=10s

# Bearer token Argo CD Notifications must send to POST /api/cost-analysis/on-sync.
# Required, at least 16 characters: generate one with `openssl rand -hex 24`.
WEBHOOK_SECRET=

# Argo CD Application ("<namespace>:<name>") whose viewers may see cluster-wide cost data.
# Empty turns cluster-wide endpoints off.
CLUSTER_SCOPE_APP=

# Days of each application's daily cost to keep, so long Trends ranges do not depend on
# Prometheus retention. 0 turns recording off.
DAILY_HISTORY_DAYS=400

# Rightsizing from Vertical Pod Autoscaler recommendations (Goldilocks or any VPA). Works only when
# the service runs in the cluster with permission to list verticalpodautoscalers.
VPA_ENABLED=true
