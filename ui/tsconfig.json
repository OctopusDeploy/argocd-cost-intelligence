{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Bundler mode */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    /* Classic React.createElement: Argo CD 3.4 exposes no ReactJSXRuntime global, so "react-jsx"
       would fail to load there. */
    "jsx": "react",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* No declarations: the build output is a browser bundle Argo CD loads, and emitting them
       wrote .d.ts files next to every source. */
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "types"]
}
